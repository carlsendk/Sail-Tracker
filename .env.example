# App
# Runtime mode for local development and server-side execution.
NODE_ENV=development
# Product name used in UI and metadata.
NEXT_PUBLIC_APP_NAME="Sail Tracker"
# Default locale when no tenant or user preference has been resolved.
NEXT_PUBLIC_DEFAULT_LOCALE=en
# Comma-separated list of supported locales.
NEXT_PUBLIC_SUPPORTED_LOCALES=en,da

# Tenant routing
# Root domain used to derive tenant hostnames.
NEXT_PUBLIC_ROOT_DOMAIN=localhost
# Baseline demo tenant slug.
NEXT_PUBLIC_DEMO_TENANT_SLUG=demo
# Baseline real tenant slug.
NEXT_PUBLIC_REAL_TENANT_SLUG=club
# Temporary local fallback when browsing plain localhost instead of a tenant hostname.
NEXT_PUBLIC_ENABLE_LOCALHOST_TENANT_FALLBACK=true

# Supabase
# Project URL from the Supabase Connect dialog.
NEXT_PUBLIC_SUPABASE_URL=
# Browser-safe public key from Supabase.
# Use the Publishable key from the Connect dialog here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Backend-only elevated key for bootstrap and admin operations.
# Use a Secret key (sb_secret_...) from Settings -> API Keys.
# Never use the Publishable key or Anon key here.
SUPABASE_SECRET_KEY=
# Display name assigned to the bootstrap platform admin profile.
SUPABASE_BOOTSTRAP_DISPLAY_NAME="Platform Admin"

# Platform
# Email used by the bootstrap script for the initial platform admin.
PLATFORM_ADMIN_EMAIL=
