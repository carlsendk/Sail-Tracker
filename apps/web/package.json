{
  "type": "commonjs",
  "name": "web",
  "description": "Next.js web application for the Sail Tracker platform.",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev --hostname 127.0.0.1 --port 3002",
    "lint": "eslint .",
    "start": "next start --hostname 127.0.0.1 --port 3002",
    "test": "vitest run",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "next": "15.2.2",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@types/node": "22.13.10",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "^9.38.0",
    "eslint-config-next": "15.2.2",
    "typescript": "6.0.3",
    "vitest": "4.1.5"
  }
}
