{
  "type": "module",
  "name": "sail-tracker",
  "description": "Multi-tenant sailing trip management platform — monorepo root.",
  "private": true,
  "version": "0.2.1",
  "packageManager": "pnpm@10.32.1+sha512.a706938f0e89ac1456b6563eab4edf1d1faf3368d1191fc5c59790e96dc918e4456ab2e67d613de1043d2e8c81f87303e6b40d4ffeca9df15ef1ad567348f2be",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "bootstrap:supabase": "node scripts/bootstrap-supabase.mjs",
    "build": "pnpm --filter web build",
    "dev": "pnpm --filter web dev",
    "format": "prettier --write \"**/*.{ts,tsx,mts,cts,mjs,cjs,js,jsx,mdx,json,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,mts,cts,mjs,cjs,js,jsx,mdx,json,yml,yaml}\"",
    "hooks:install": "node scripts/install-git-hooks.mjs",
    "lint": "eslint .",
    "start": "pnpm --filter web start",
    "stylelint": "stylelint \"**/*.css\"",
    "test": "node --test 'tests/*.mjs' && pnpm --filter web test",
    "typecheck": "pnpm --filter web typecheck",
    "validate": "pnpm format:check && pnpm stylelint && pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.1",
    "@eslint/js": "^9.22.0",
    "@next/eslint-plugin-next": "^16.2.5",
    "eslint": "9.39.4",
    "eslint-plugin-anti-trojan-source": "^1.1.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest-dom": "^5.5.0",
    "eslint-plugin-jsdoc": "^62.9.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-mdx": "^3.7.0",
    "eslint-plugin-no-only-tests": "^3.4.0",
    "eslint-plugin-no-secrets": "^2.3.3",
    "eslint-plugin-package-json": "^0.91.2",
    "eslint-plugin-perfectionist": "^5.9.0",
    "eslint-plugin-playwright": "^2.10.2",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-regexp": "^3.1.0",
    "eslint-plugin-security": "^4.0.0",
    "eslint-plugin-sonarjs": "^4.0.3",
    "eslint-plugin-testing-library": "^7.16.2",
    "eslint-plugin-unicorn": "^64.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "eslint-plugin-vitest": "^0.5.4",
    "eslint-plugin-yml": "^3.3.2",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "stylelint": "^17.11.0",
    "stylelint-config-standard": "^40.0.0",
    "supabase": "^2.78.1",
    "typescript-eslint": "^8.59.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "supabase",
      "unrs-resolver"
    ]
  }
}
