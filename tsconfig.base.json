{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@sail-tracker/domain": ["packages/domain/src/index.ts"],
      "@sail-tracker/application": ["packages/application/src/index.ts"],
      "@sail-tracker/infrastructure": ["packages/infrastructure/src/index.ts"],
      "@sail-tracker/ui": ["packages/ui/src/index.ts"],
      "@sail-tracker/testkit": ["packages/testkit/src/index.ts"]
    }
  }
}

